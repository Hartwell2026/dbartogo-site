{
  "functions": {
    "api/*.js": { "memory": 256, "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)\\.(html|css|js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
